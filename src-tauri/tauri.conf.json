{
  "$schema": "https://schema.tauri.app/config/3.0.0-alpha.json",
  "productName": "tauri-v3-cef-demo",
  "version": "0.1.0",
  "identifier": "com.demo.v3cef",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "光影画廊 · Tauri v3 CEF",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": []
  }
}
